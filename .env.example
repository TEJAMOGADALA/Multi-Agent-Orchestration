# ============================================================
# DevAgent — Multi-Agent Orchestration System
# .env.example — Copy this to .env and fill in your values
# ============================================================
# cp .env.example .env
#
# SECURITY: Never commit your .env file. It is excluded via
# .gitignore. Only this template (.env.example) is tracked.
# ============================================================


# ----------------------------------------------------------
# 1. APPLICATION
# ----------------------------------------------------------
APP_NAME=DevAgent
APP_ENV=development                    # development | staging | production
APP_DEBUG=true                         # Enables verbose logging; disable in production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Secret key for signing JWTs and session tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=CHANGE_ME_generate_a_secure_random_key

# Comma-separated list of valid API keys for client authentication
APP_API_KEYS=dev-key-change-me-1,dev-key-change-me-2


# ----------------------------------------------------------
# 2. LLM PROVIDERS
# ----------------------------------------------------------
# Primary LLM — used by orchestrator and agents
# Supported: openai | azure_openai | anthropic | google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o                      # Model identifier for the provider
LLM_TEMPERATURE=0.1                    # Low temperature for deterministic agent behavior
LLM_MAX_TOKENS=4096                    # Max tokens per LLM response
LLM_REQUEST_TIMEOUT=60                 # Seconds before LLM request times out

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=                         # Optional: OpenAI organization ID

# Azure OpenAI (if LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=                # e.g., https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=              # Deployment name in Azure

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Google AI / Gemini (if LLM_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=

# Fallback LLM — used when primary provider fails
LLM_FALLBACK_PROVIDER=                 # Leave empty to disable fallback
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=


# ----------------------------------------------------------
# 3. POSTGRESQL — Task history, audit logs, agent metadata
# ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devagent
POSTGRES_USER=devagent
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Full connection URL (auto-constructed if not set)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=

# Connection pool settings
POSTGRES_POOL_SIZE=10                  # Max persistent connections
POSTGRES_MAX_OVERFLOW=20               # Max additional connections under load
POSTGRES_POOL_TIMEOUT=30               # Seconds to wait for a connection


# ----------------------------------------------------------
# 4. REDIS — Shared agent memory, session cache, rate limiting
# ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                        # Leave empty for local dev without auth
REDIS_DB=0                             # Redis database number (0-15)
REDIS_SSL=false                        # Enable for production Redis (e.g., ElastiCache)

# Full connection URL (overrides individual settings if set)
# REDIS_URL=redis://:password@host:port/db
REDIS_URL=

# TTL defaults (seconds)
REDIS_DEFAULT_TTL=3600                 # 1 hour — default key expiry
REDIS_SESSION_TTL=86400                # 24 hours — session/context expiry


# ----------------------------------------------------------
# 5. PINECONE — Vector search for RAG-powered agents
# ----------------------------------------------------------
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1         # Pinecone cloud region
PINECONE_INDEX_NAME=devagent-knowledge
PINECONE_DIMENSION=1536                # Must match embedding model dimension
PINECONE_METRIC=cosine                 # cosine | euclidean | dotproduct

# Embedding model (for vectorizing text before Pinecone storage)
EMBEDDING_PROVIDER=openai              # openai | huggingface | cohere
EMBEDDING_MODEL=text-embedding-3-small


# ----------------------------------------------------------
# 6. TOOLS — API keys for agent tools
# ----------------------------------------------------------
# Web Search (Tavily — recommended for LLM-optimized results)
TAVILY_API_KEY=tvly-your-tavily-api-key

# Fallback search (SerpAPI)
SERPAPI_API_KEY=

# GitHub (for Coding Agent & GitHub integration)
GITHUB_TOKEN=ghp_your-github-personal-access-token
GITHUB_DEFAULT_ORG=                    # Optional: default GitHub organization

# Code Execution Sandbox
CODE_EXECUTOR_TIMEOUT=30               # Max seconds for sandboxed code execution
CODE_EXECUTOR_MAX_MEMORY_MB=256        # Memory limit for sandboxed processes
CODE_EXECUTOR_DOCKER_IMAGE=python:3.12-slim   # Docker image for isolated execution


# ----------------------------------------------------------
# 7. MCP (Model Context Protocol) — External tool servers
# ----------------------------------------------------------
# MCP client settings
MCP_DISCOVERY_ENABLED=true             # Auto-discover tools from configured servers
MCP_CLIENT_TIMEOUT=30                  # Seconds before MCP tool call times out
MCP_MAX_RETRIES=3                      # Retry attempts for failed MCP calls
MCP_CACHE_TTL=300                      # Seconds to cache MCP tool schemas

# MCP server authentication tokens (referenced in mcp_config.json)
# Each MCP server can have its own auth token stored here
MCP_AUTH_TOKEN_CHROME_DEVTOOLS=        # Auth token for Chrome DevTools MCP
MCP_AUTH_TOKEN_MONGODB=                # Auth token for MongoDB MCP
MCP_AUTH_TOKEN_CUSTOM=                 # Auth token for custom MCP servers

# DevAgent MCP Server (exposes DevAgent as an MCP provider)
MCP_SERVER_ENABLED=false               # Enable DevAgent's own MCP server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_AUTH_TOKEN=                 # Token required to call DevAgent via MCP


# ----------------------------------------------------------
# 8. MONITORING & OBSERVABILITY
# ----------------------------------------------------------
# OpenTelemetry
OTEL_ENABLED=false                     # Enable distributed tracing
OTEL_EXPORTER_ENDPOINT=http://localhost:4317   # OTLP gRPC endpoint
OTEL_SERVICE_NAME=devagent
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0           # 1.0 = trace everything (reduce in prod)

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090                   # Prometheus scrape port

# Grafana (for reference — not consumed by app)
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=admin

# Cost Tracking
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD_USD=50.00        # Alert when cumulative cost exceeds this


# ----------------------------------------------------------
# 9. EXTERNAL INTEGRATIONS
# ----------------------------------------------------------
# Slack — Task completion notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#devagent-alerts
SLACK_ENABLED=false

# Notion — Knowledge base sync
NOTION_API_KEY=ntn_your-notion-integration-token
NOTION_DATABASE_ID=                    # Notion database for task results
NOTION_ENABLED=false

# GitHub Integrations (uses GITHUB_TOKEN from section 6)
GITHUB_WEBHOOK_SECRET=                 # For verifying incoming GitHub webhooks


# ----------------------------------------------------------
# 10. RATE LIMITING & SECURITY
# ----------------------------------------------------------
# API rate limiting (requests per window per API key)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# LLM rate limiting (to control costs)
LLM_RATE_LIMIT_RPM=60                 # Max LLM requests per minute
LLM_RATE_LIMIT_TPM=100000             # Max LLM tokens per minute

# CORS (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Request size limits
MAX_REQUEST_SIZE_MB=10                 # Max payload size for API requests
MAX_TASK_DESCRIPTION_LENGTH=10000      # Max characters in a task description


# ----------------------------------------------------------
# 11. AGENT CONFIGURATION
# ----------------------------------------------------------
# Maximum subtasks the orchestrator can create per query
ORCHESTRATOR_MAX_SUBTASKS=10

# Maximum retries for a failed agent subtask
AGENT_MAX_RETRIES=3

# Timeout for entire orchestration pipeline (seconds)
ORCHESTRATOR_TIMEOUT=300               # 5 minutes max per task

# Agent concurrency — max parallel agent executions
AGENT_MAX_CONCURRENCY=5
